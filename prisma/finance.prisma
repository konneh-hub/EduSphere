enum InvoiceStatus { UNPAID PARTIALLY_PAID PAID CANCELLED }
enum PaymentMethod { CASH BANK_TRANSFER MOBILE_MONEY CARD OTHER }
enum DiscountType { FIXED PERCENTAGE }
enum ScholarshipStatus { ACTIVE EXPIRED CANCELLED }
enum ReceiptStatus { ISSUED VOID }

model FeeCategory {
  id String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid
  name String
  description String?
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  fees Fee[]
  @@unique([schoolId, name])
}

model Fee {
  id String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid
  categoryId String? @db.Uuid
  academicYearId String @db.Uuid
  name String
  amount Decimal @db.Decimal(12,2)
  description String?
  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  category FeeCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  structures FeeStructure[]
  invoices Invoice[]
  @@index([schoolId, academicYearId])
}

model FeeStructure {
  id String @id @default(uuid()) @db.Uuid
  feeId String @db.Uuid
  termId String @db.Uuid
  classId String? @db.Uuid
  amount Decimal @db.Decimal(12,2)
  fee Fee @relation(fields: [feeId], references: [id], onDelete: Cascade)
  term Term @relation(fields: [termId], references: [id], onDelete: Restrict)
  class SchoolClass? @relation(fields: [classId], references: [id], onDelete: SetNull)
  @@unique([feeId, termId, classId])
}

model Discount {
  id String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid
  name String
  type DiscountType
  value Decimal @db.Decimal(12,2)
  active Boolean @default(true)
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  invoices Invoice[]
  @@unique([schoolId, name])
}

model Scholarship {
  id String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid
  studentId String @db.Uuid
  name String
  amount Decimal @db.Decimal(12,2)
  percentage Decimal? @db.Decimal(5,2)
  status ScholarshipStatus @default(ACTIVE)
  startDate DateTime
  endDate DateTime?
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  @@index([schoolId, studentId])
}

model Invoice {
  id String @id @default(uuid()) @db.Uuid
  studentId String @db.Uuid
  feeId String @db.Uuid
  discountId String? @db.Uuid
  invoiceNumber String
  amount Decimal @db.Decimal(12,2)
  discountAmount Decimal @default(0) @db.Decimal(12,2)
  balance Decimal @db.Decimal(12,2)
  dueDate DateTime?
  status InvoiceStatus @default(UNPAID)
  createdAt DateTime @default(now())
  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  fee Fee @relation(fields: [feeId], references: [id], onDelete: Restrict)
  discount Discount? @relation(fields: [discountId], references: [id], onDelete: SetNull)
  payments Payment[]
  receipts Receipt[]
  @@unique([studentId, invoiceNumber])
  @@index([studentId, status])
}

model Payment {
  id String @id @default(uuid()) @db.Uuid
  invoiceId String @db.Uuid
  amount Decimal @db.Decimal(12,2)
  method PaymentMethod
  reference String?
  paidAt DateTime @default(now())
  recordedById String? @db.Uuid
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  receipt Receipt?
  @@index([invoiceId, paidAt])
  @@unique([method, reference])
}

model Receipt {
  id String @id @default(uuid()) @db.Uuid
  invoiceId String @db.Uuid
  paymentId String @unique @db.Uuid
  receiptNumber String @unique
  amount Decimal @db.Decimal(12,2)
  status ReceiptStatus @default(ISSUED)
  issuedAt DateTime @default(now())
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
}
