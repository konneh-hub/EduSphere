# EduSphere environment template
# Never commit real secrets. Copy to .env.local for local development.

NODE_ENV=development
NEXT_PUBLIC_APP_NAME=EduSphere
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL / Prisma
# Example local value:
# postgresql://postgres:postgres@localhost:5432/edusphere?schema=public
DATABASE_URL=

# Authentication/session secrets
AUTH_SECRET=

# Clerk authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional application configuration
LOG_LEVEL=info
